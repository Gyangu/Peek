{
  "name": "@peek/core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "peek frozen shared contract: commands, Workspace state, capability interfaces, chunk protocol, IPC protocol",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "node --import ./src/__tests__/register.mjs --test src/__tests__/*.test.ts"
  },
  "dependencies": {
    "immer": "^11.1.15",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.9.3"
  }
}
