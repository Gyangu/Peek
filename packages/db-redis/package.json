{
  "name": "@peek/db-redis",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "peek Redis driver: introspect + collectionScan(SCAN) + keyValue + valuePeek + cancel",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./manifest": {
      "types": "./src/manifest.ts",
      "default": "./src/manifest.ts"
    },
    "./display": {
      "types": "./src/display.ts",
      "default": "./src/display.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import ./src/__tests__/register.mjs --test src/__tests__/*.test.ts"
  },
  "dependencies": {
    "@peek/core": "workspace:*",
    "redis": "^6.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.9.3"
  }
}
