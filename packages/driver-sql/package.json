{
  "name": "@peek/driver-sql",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "peek MySQL / SQLite driver: one dialect layer, two databases (introspect + tabularQuery + collectionScan + valuePeek + cancel)",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./manifest": {
      "types": "./src/manifest.ts",
      "default": "./src/manifest.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import ./src/__tests__/register.mjs --test src/__tests__/*.test.ts"
  },
  "dependencies": {
    "@peek/core": "workspace:*",
    "mysql2": "^3.23.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.9.3"
  }
}
