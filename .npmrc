# peek workspace install configuration
# Strict peer dependencies are noise in the React 19 ecosystem. Off.
strict-peer-dependencies=false
auto-install-peers=true

# The electron binary comes from the official source by default. Uncomment the
# line below to use a mirror where that source is unreachable.
# electron_mirror=https://npmmirror.com/mirrors/electron/

# Keep node_modules isolated (the default): a driver package may have no
# phantom dependency.
shamefully-hoist=false
