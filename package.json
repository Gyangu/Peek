{
  "name": "peek",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @peek/desktop dev",
    "build": "pnpm --filter @peek/desktop build",
    "typecheck": "pnpm -r --no-bail typecheck",
    "check:vocabulary": "node scripts/check-package-vocabulary.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm run format:check && pnpm run check:vocabulary && pnpm -r --no-bail test",
    "icon": "pnpm --filter @peek/desktop icon",
    "package": "pnpm --filter @peek/desktop package",
    "install:local": "pnpm --filter @peek/desktop install:local"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "electron-vite": "^5.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
