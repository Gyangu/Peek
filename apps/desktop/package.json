{
  "name": "@peek/desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "peek Electron shell: main / preload / renderer",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "pnpm run build:packages && pnpm run build:package-host && electron-vite dev",
    "build": "pnpm run build:packages && electron-vite build && pnpm run build:package-host && node scripts/audit-package-boundary.mjs && node scripts/audit-shipped-css.mjs && pnpm run probe:render",
    "build:packages": "node scripts/build-packages.mjs",
    "build:package-host": "electron-vite build --config electron.vite.package-host.config.ts",
    "audit:css": "node scripts/audit-shipped-css.mjs",
    "audit:packages": "node scripts/audit-package-boundary.mjs",
    "probe:render": "electron scripts/render-probe/probe-main.mjs",
    "probe:hardening": "electron scripts/probe-hardening.mjs",
    "verify:fuses": "node scripts/verify-fuses.mjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import ./src/main/bus/__tests__/ts-resolve.hooks.mjs --test \"src/main/__tests__/*.test.ts\" \"src/main/bus/__tests__/*.test.ts\" \"src/main/connections/__tests__/*.test.ts\" \"src/main/packages/__tests__/*.test.ts\" \"src/main/mcp/__tests__/*.test.ts\" \"src/main/acp/**/__tests__/*.test.ts\" \"src/main/agent/**/__tests__/*.test.ts\" \"src/drivers/**/__tests__/*.test.ts\" \"src/renderer/**/__tests__/*.test.ts\"",
    "test:hardening": "node --import ./src/main/bus/__tests__/ts-resolve.hooks.mjs --test \"src/main/__tests__/hardening.test.ts\"",
    "icon": "node scripts/make-icns.mjs",
    "package": "pnpm run build && node scripts/package-mac.mjs",
    "install:local": "pnpm run package && node scripts/install-mac.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.64.0",
    "@agentclientprotocol/codex-acp": "1.1.9",
    "@agentclientprotocol/sdk": "1.3.0",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@earendil-works/pi-agent-core": "^0.83.0",
    "@earendil-works/pi-ai": "^0.83.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@peek/core": "workspace:*",
    "@peek/db-neo4j": "workspace:*",
    "@peek/db-postgres": "workspace:*",
    "@peek/db-qdrant": "workspace:*",
    "@peek/db-redis": "workspace:*",
    "@peek/db-sql": "workspace:*",
    "@tanstack/react-virtual": "^3.14.9",
    "codemirror": "^6.0.2",
    "immer": "^11.1.15",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@electron/packager": "^20.0.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.2.0",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
