{
  // Standalone typecheck config for the Node side (main / preload / build config).
  // It sits alongside tsconfig.json rather than using project references:
  // composite mode wants .d.ts emitted first, which only gets in the way while
  // several agents work in parallel.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node", "electron-vite/node"]
  },
  "include": [
    "electron.vite.config.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts"
  ]
}
