{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,

    /* Strict mode, uniform across the project: no `any` (use `unknown` plus narrowing) */
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "useUnknownInCatchVariables": true,
    /* The checks below are off on purpose: too noisy while several agents develop in
       parallel. Turn them on once things settle. */
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,

    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    /* Lets any package import @peek/core straight from source, with no build step first */
    "baseUrl": ".",
    "paths": {
      "@peek/core": ["./packages/core/src/index.ts"],
      "@peek/core/*": ["./packages/core/src/*"],
      "@peek/db-postgres": ["./packages/db-postgres/src/index.ts"],
      "@peek/db-postgres/*": ["./packages/db-postgres/src/*"],
      "@peek/db-redis": ["./packages/db-redis/src/index.ts"],
      "@peek/db-redis/*": ["./packages/db-redis/src/*"],
      "@peek/db-qdrant": ["./packages/db-qdrant/src/index.ts"],
      "@peek/db-qdrant/*": ["./packages/db-qdrant/src/*"],
      "@peek/db-sql": ["./packages/db-sql/src/index.ts"],
      "@peek/db-sql/*": ["./packages/db-sql/src/*"],
      "@peek/db-neo4j": ["./packages/db-neo4j/src/index.ts"],
      "@peek/db-neo4j/*": ["./packages/db-neo4j/src/*"]
    }
  }
}
